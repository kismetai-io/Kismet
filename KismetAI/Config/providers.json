			"key_slot": "custom-openai",
			"auth": "bearer",
			"custom_models": true,
			"_comment": "The base includes the /v1 prefix (chat goes to {base}/chat/completions), so the list is {base}/models. Covers llama.cpp llama-server and vLLM.",
