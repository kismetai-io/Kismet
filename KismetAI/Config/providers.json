			"id": "custom-anthropic",
			"display_name": "Custom (Anthropic-compatible)",
			"protocol": "anthropic_messages",
			"base_url": "",
			"key_slot": "custom-anthropic",
			"auth": "x-api-key",
			"custom_models": true,
			"models_url": "{base}/v1/models",
