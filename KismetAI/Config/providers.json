{
	"schema_version": 1,
	"_comment": "Provider profiles: where a request goes and how it authenticates. A model's 'provider' in models.json names one of these; a run can also pick a profile explicitly. 'key_slot' names the encrypted key file (~/.kismet/<slot>_key.enc) and the in-memory key; the anthropic/openai/minimax slots are the same files KismetAI has always used. Base URLs: a user override in settings wins, then 'base_url_env', then 'base_url'. Endpoints checked 2026-11-06 against each vendor's docs. 'models_url' / 'models_format' name the model list the picker refreshes from at runtime ({base} = resolved base URL, {origin} = its scheme://host); list endpoints checked 2026-11-25. Z.ai and MiniMax publish no documented list, so they keep the curated rows.",
	"providers": [
		{
			"id": "anthropic",
			"display_name": "Anthropic",
			"protocol": "anthropic_messages",
			"base_url": "https://api.anthropic.com",
			"key_slot": "anthropic",
			"key_env": "ANTHROPIC_API_KEY",
			"auth": "x-api-key",
			"prompt_cache_markers": true,
			"key_url": "https://platform.claude.com/settings/keys",
			"models_url": "{base}/v1/models?limit=1000",
			"models_format": "anthropic",
			"models_headers": { "anthropic-version": "2023-06-01" }
		},
		{
			"id": "openai",
			"display_name": "OpenAI",
			"protocol": "openai_responses",
			"base_url": "https://api.openai.com",
			"base_url_env": "OPENAI_BASE_URL",
			"key_slot": "openai",
			"key_env": "OPENAI_API_KEY",
			"auth": "bearer",
			"key_url": "https://platform.openai.com/api-keys",
			"models_url": "{base}/v1/models",
			"models_format": "openai"
		},
		{
			"id": "google",
			"display_name": "Google Gemini",
			"protocol": "openai_chat",
			"base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
			"key_slot": "google",
			"key_env": "GEMINI_API_KEY",
			"auth": "bearer",
			"key_url": "https://aistudio.google.com/apikey",
			"_comment": "The native list (not the OpenAI-compatible one) reports inputTokenLimit/outputTokenLimit; it takes the key as x-goog-api-key.",
			"models_url": "{origin}/v1beta/models?pageSize=1000",
			"models_format": "google",
			"models_auth": "x-goog-api-key"
		},
		{
			"id": "deepseek",
			"display_name": "DeepSeek",
			"protocol": "anthropic_messages",
			"base_url": "https://api.deepseek.com/anthropic",
			"key_slot": "deepseek",
			"key_env": "DEEPSEEK_API_KEY",
			"auth": "x-api-key+bearer",
			"key_url": "https://platform.deepseek.com/api_keys",
			"models_url": "{origin}/models",
			"models_format": "openai"
		},
		{
			"id": "zai",
			"display_name": "Z.ai (GLM)",
			"protocol": "anthropic_messages",
			"base_url": "https://api.z.ai/api/anthropic",
