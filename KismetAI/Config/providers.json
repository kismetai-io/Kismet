{
	"schema_version": 1,
	"_comment": "Provider profiles: where a request goes and how it authenticates. A model's 'provider' in models.json names one of these; a run can also pick a profile explicitly. 'key_slot' names the encrypted key file (~/.kismet/<slot>_key.enc) and the in-memory key; the anthropic/openai/minimax slots are the same files KismetAI has always used. Base URLs: a user override in settings wins, then 'base_url_env', then 'base_url'. Endpoints checked 2026-11-06 against each vendor's docs.",
	"providers": [
		{
			"id": "anthropic",
			"display_name": "Anthropic",
			"protocol": "anthropic_messages",
			"base_url": "https://api.anthropic.com",
			"key_slot": "anthropic",
			"key_env": "ANTHROPIC_API_KEY",
			"auth": "x-api-key",
			"prompt_cache_markers": true,
			"key_url": "https://platform.claude.com/settings/keys"
		},
		{
			"id": "openai",
			"display_name": "OpenAI",
			"protocol": "openai_responses",
			"base_url": "https://api.openai.com",
			"base_url_env": "OPENAI_BASE_URL",
			"key_slot": "openai",
			"key_env": "OPENAI_API_KEY",
			"auth": "bearer",
			"key_url": "https://platform.openai.com/api-keys"
		},
		{
			"id": "google",
			"display_name": "Google Gemini",
			"protocol": "openai_chat",
			"base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
